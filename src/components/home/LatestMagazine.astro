---
import { magazines } from '../../data/magazines';

// The latest issue is the last entry of the magazines array.
const latest = magazines[magazines.length - 1];

const container = 'mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8';
const muted = 'text-primary-950/70 dark:text-primary-200/70';
const focusRing =
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-400';
---

{latest && (
  <section class="py-16 sm:py-20" aria-labelledby="latest-magazine-title">
    <div class={container}>
      <div class="grid items-center gap-10 rounded-3xl border border-primary-200/50 bg-primary-500/5 p-6 dark:border-primary-800/50 dark:bg-primary-400/5 sm:p-10 md:grid-cols-12 lg:gap-16 lg:p-12">
        <a
          href={`/magazine/${latest.slug}`}
          class={`group mx-auto block w-full max-w-xs overflow-hidden rounded-2xl border border-primary-200/60 bg-primary-100 shadow-sm transition hover:shadow-xl hover:shadow-primary-700/10 dark:border-primary-700/40 dark:bg-primary-800 md:col-span-5 md:max-w-none lg:col-span-4 ${focusRing}`}
          aria-label={`Leer ${latest.title}`}
        >
          <img
            src={latest.coverImage}
            alt={`Portada de ${latest.title}`}
            class="aspect-[3/4] h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
            loading="lazy"
          />
        </a>

        <div class="flex flex-col items-start gap-5 md:col-span-7 lg:col-span-8">
          <p class="text-sm font-medium uppercase tracking-wider text-accent-700 dark:text-accent-300">
            Última edición
          </p>
          <h2
            id="latest-magazine-title"
            class="text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl"
          >
            {latest.title}
          </h2>
          <p class={`${muted} max-w-xl text-lg leading-relaxed`}>{latest.description}</p>

          <div class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
            <a
              href={`/magazine/${latest.slug}`}
              class={`group inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-transparent bg-primary-700 px-6 py-3 text-base font-medium text-white transition hover:bg-primary-800 dark:bg-primary-400 dark:text-primary-950 dark:hover:bg-primary-300 ${focusRing}`}
            >
              Leer revista
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
              </svg>
            </a>
            <a
              href="/magazine"
              class={`inline-flex min-h-11 items-center justify-center rounded-full px-4 py-3 text-base font-medium text-primary-700 underline-offset-4 transition hover:underline dark:text-primary-300 ${focusRing}`}
            >
              Ver todas las revistas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
